{
  "name": "agentpos-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Turn any fiat e-commerce site into an agent-buyable store. x402 on Stellar, UCP/ACP surfaces, Shopify/WooCommerce connectors.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.5"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e:smoke": "pnpm --filter @agentpos/core e2e:smoke",
    "e2e:testnet": "pnpm --filter @agentpos/mcp-buyer e2e:testnet",
    "demo:up": "docker compose -f apps/demo-store/docker-compose.yml up -d",
    "demo:down": "docker compose -f apps/demo-store/docker-compose.yml down -v",
    "demo:logs": "docker compose -f apps/demo-store/docker-compose.yml logs -f wpcli",
    "prepare": "git config core.hooksPath .githooks || true",
    "gate:check": "pnpm --filter @agentpos/site gate:check",
    "release:check": "node scripts/check-publish.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  }
}
