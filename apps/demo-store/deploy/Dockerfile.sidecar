# AgentPOS sidecar as a container, for the public demo store (and as the template any
# merchant deployment can copy). Built from the monorepo root:
#   docker build -f apps/demo-store/deploy/Dockerfile.sidecar -t agentpos-sidecar .
FROM node:22-alpine AS build
WORKDIR /app
ENV CI=true
RUN corepack enable
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY packages ./packages
RUN pnpm install --frozen-lockfile --filter @agentpos/site... --filter @agentpos/mcp-buyer... \
 && pnpm -r --filter @agentpos/site... --filter @agentpos/mcp-buyer... build \
 && pnpm prune --prod

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
# The sidecar signs nothing and holds no funds, but it does hold the Woo REST key: never root.
USER node
COPY --from=build --chown=node:node /app /app
COPY --chown=node:node apps/demo-store/deploy/seed-catalog.mjs /app/apps-demo-seed/seed-catalog.mjs
# /data holds agentpos.config.json and the .agentpos dir (SQLite + receipt signer). Mount it.
WORKDIR /data
EXPOSE 8402
CMD ["node", "/app/packages/site/bin/agentpos.js", "serve"]
