{
  "name": "@agentpos/facilitator",
  "version": "0.0.1",
  "description": "A minimal, self-hostable x402 facilitator for Stellar: verify, settle and supported, built on the official @x402 SDKs. Exists so a store's ability to sell does not depend on one hosted service run by someone else.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "lint": "eslint src",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "keygen": "tsx src/keygen.ts"
  },
  "dependencies": {
    "@agentpos/core": "workspace:*",
    "@hono/node-server": "^2.1.4",
    "@stellar/stellar-sdk": "^16.3.1",
    "@x402/core": "2.23.0",
    "@x402/stellar": "2.23.0",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
