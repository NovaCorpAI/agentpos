# TLS front for the facilitator. Certificates are automatic (Let's Encrypt); the DNS record for
# this name must be DNS-only in Cloudflare (grey cloud) so the ACME challenge reaches Caddy.
#
# No rate limiting here on purpose: the stock caddy image does not ship the rate_limit module,
# and a directive it cannot parse would keep the whole front from starting. The facilitator
# authenticates every call itself (constant-time key check, 401 otherwise), which is the control
# that actually protects the fee balance. If junk traffic ever becomes a real cost, add
# Cloudflare proxying with an Origin Rule for ACME, or build Caddy with mholt/caddy-ratelimit.
facilitator.novacorplabs.com {
	reverse_proxy facilitator:8403
	encode gzip
}

# The official AgentPOS demo store. AgentPOS routes go to the sidecar; everything else is the
# WooCommerce storefront. Same split any lighthouse store uses on its own server.
demo.agentposhq.com {
	@agentpos path /agentpos/* /.well-known/ucp /openapi.json /llms.txt
	handle @agentpos {
		reverse_proxy demo-sidecar:8402
	}
	handle {
		reverse_proxy demo-wordpress:80
	}
	encode gzip
}

# The buyer space (private surface: the owner's mandate, proposals and activity). It can raise
# spending limits and approve payments, so it is gated here until buyer-web has a login of its
# own: HTTP basic auth with the hash in BUYER_WEB_BASIC_HASH (server env, never in the repo).
# Twilio cannot send basic credentials, so the WhatsApp webhook is exempt: it authenticates
# every request itself by verifying Twilio's signature and answers 401 otherwise.
agente.agentposhq.com {
	@webhooks path /whatsapp/*
	handle @webhooks {
		reverse_proxy buyer-web:8788
	}
	handle {
		basic_auth {
			anael {env.BUYER_WEB_BASIC_HASH}
		}
		reverse_proxy buyer-web:8788
	}
	encode gzip
}
