{
  "name": "@agentpos/merchant-web",
  "version": "0.0.1",
  "description": "Merchant onboarding wizard: a stateless web page where a store owner produces a valid AgentPOS configuration and verifies their deployment, without reading docs. No accounts, no database, nothing stored server-side.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "lint": "eslint src",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@agentpos/core": "workspace:*",
    "@agentpos/site": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@stellar/stellar-sdk": "^16.2.0",
    "hono": "^4.13.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
