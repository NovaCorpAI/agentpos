{
  "name": "@agentpos/mcp-buyer",
  "version": "0.0.1",
  "description": "AgentPOS buyer: MCP server that lets any agent discover, quote and buy from agent-buyable stores within a human mandate (x402 on Stellar).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentpos-buyer": "./bin/agentpos-buyer.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "lint": "eslint src bin scripts",
    "dev": "tsx src/cli.ts serve",
    "e2e:testnet": "tsx scripts/e2e-testnet.ts"
  },
  "dependencies": {
    "@agentpos/core": "workspace:*",
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@stellar/stellar-sdk": "^16.2.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@agentpos/connectors": "workspace:*",
    "@agentpos/scanner": "workspace:*",
    "@agentpos/site": "workspace:*",
    "@types/node": "^24.13.3",
    "@x402/core": "2.23.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
