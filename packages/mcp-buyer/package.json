{
  "name": "@agentpos/mcp-buyer",
  "version": "0.1.5",
  "description": "AgentPOS buyer: MCP server that lets any agent discover, quote and buy from agent-buyable stores within a human mandate (x402 on Stellar).",
  "license": "Apache-2.0",
  "homepage": "https://agentposhq.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NovaCorpAI/agentpos.git",
    "directory": "packages/mcp-buyer"
  },
  "bugs": {
    "url": "https://github.com/NovaCorpAI/agentpos/issues"
  },
  "engines": {
    "node": ">=22.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentpos-buyer": "./bin/agentpos-buyer.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bin/agentpos-buyer.js": "./bin/agentpos-buyer.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "lint": "eslint src bin scripts",
    "dev": "tsx src/cli.ts serve",
    "e2e:testnet": "tsx scripts/e2e-testnet.ts"
  },
  "dependencies": {
    "@agentpos/core": "workspace:^",
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@stellar/stellar-sdk": "^16.3.1",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@agentpos/connectors": "workspace:^",
    "@agentpos/scanner": "workspace:^",
    "@agentpos/site": "workspace:^",
    "@types/node": "^24.19.2",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
