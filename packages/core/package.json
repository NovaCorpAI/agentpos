{
  "name": "@agentgate/core",
  "version": "0.0.1",
  "description": "AgentGate core: config, money types, protocol adapters (x402, UCP, ACP), signer factory, LLM router, fiscal interface.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "lint": "eslint src scripts",
    "e2e:smoke": "tsx scripts/e2e-smoke.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "@x402/core": "2.23.0",
    "@x402/fetch": "2.23.0",
    "@x402/stellar": "2.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
