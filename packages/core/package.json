{
  "name": "@agentpos/core",
  "version": "0.1.5",
  "description": "AgentPOS core: config, money types, protocol adapters (x402, UCP, ACP), signer factory, LLM router, fiscal interface.",
  "license": "Apache-2.0",
  "homepage": "https://agentposhq.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NovaCorpAI/agentpos.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/NovaCorpAI/agentpos/issues"
  },
  "engines": {
    "node": ">=22.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "lint": "eslint src scripts",
    "e2e:smoke": "tsx scripts/e2e-smoke.ts",
    "vendor:schemas": "tsx scripts/vendor-schemas.ts",
    "e2e:transbank": "tsx scripts/e2e-transbank.ts",
    "e2e:transbank:enrol": "tsx scripts/oneclick-enrol.ts"
  },
  "dependencies": {
    "@agentpos/measure": "workspace:^",
    "@stellar/stellar-sdk": "^16.3.1",
    "@x402/core": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/stellar": "2.28.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
