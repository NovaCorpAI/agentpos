{
  "name": "@agentpos/identity",
  "version": "0.0.1",
  "description": "AgentPOS Know Your Agent: Ed25519 request signatures, owner attestations and a revocable agent registry, so a merchant can require that whoever buys is an identifiable agent with a vouched owner.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "SPEC.md", "README.md"],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@agentpos/core": "workspace:*",
    "@stellar/stellar-sdk": "^16.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
