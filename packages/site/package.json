{
  "name": "@agentgate/site",
  "version": "0.0.1",
  "description": "AgentGate site library: turns a fiat e-commerce site into an agent-buyable store. Middleware or sidecar, x402 on Stellar, UCP/ACP/MCP surfaces, orders into the merchant's platform.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentgate": "./bin/agentgate.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "lint": "eslint src bin",
    "dev": "tsx src/cli.ts serve"
  },
  "dependencies": {
    "@agentgate/connectors": "workspace:*",
    "@agentgate/core": "workspace:*",
    "@agentgate/scanner": "workspace:*",
    "@clack/prompts": "^1.7.0",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@stellar/stellar-sdk": "^16.2.0",
    "@x402/hono": "2.23.0",
    "commander": "^15.0.0",
    "hono": "^4.13.4",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@x402/core": "2.23.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
