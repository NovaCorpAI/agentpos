{
  "name": "@agentpos/measure",
  "version": "0.1.2",
  "description": "AgentPOS usage measurement: one usage_events row per model call, with tokens, latency, integer cost in USD micros and the traceId of its run. Price table as configuration, CSV export and reader.",
  "license": "Apache-2.0",
  "homepage": "https://agentposhq.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NovaCorpAI/agentpos.git",
    "directory": "packages/measure"
  },
  "bugs": {
    "url": "https://github.com/NovaCorpAI/agentpos/issues"
  },
  "engines": {
    "node": ">=22.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
