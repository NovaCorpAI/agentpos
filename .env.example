# AgentPOS: copy to .env and fill in. NEVER commit .env.

# Network: testnet (default) | mainnet. Mainnet also requires AGENTPOS_ALLOW_MAINNET=true
# (guardrail 2: mainnet needs explicit founder confirmation, see plan/ROADMAP.md gate G2).
AGENTPOS_NETWORK=testnet
AGENTPOS_ALLOW_MAINNET=false
# Checkout asset: USDC (default). XLM is testnet-only, used by automated e2e (friendbot gives XLM,
# not USDC). Mainnet refuses anything but USDC.
AGENTPOS_CHECKOUT_ASSET=USDC

# Facilitator (Built on Stellar). Defaults are set per network in packages/core/src/config.ts;
# override only if you run your own facilitator.
# AGENTPOS_FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
# Facilitator API key(s), comma-separated. REQUIRED for verify/settle/supported (verified
# 2026-08-25: /supported returns 401 without it). Generate at the URL in
# developers.stellar.org/docs/build/agentic-payments/x402/built-on-stellar (testnet: no login;
# mainnet: GitHub OAuth). The key cannot be retrieved after creation.
# Keys are PER NETWORK: set the network-specific variables and keep both; the generic one is a fallback.
AGENTPOS_FACILITATOR_API_KEY_TESTNET=
AGENTPOS_FACILITATOR_API_KEY_MAINNET=
AGENTPOS_FACILITATOR_API_KEY=

# Soroban RPC. Testnet has a public default; mainnet REQUIRES a URL (no public default in SDK).
# Public mainnet endpoints verified 2026-08-26 (rate limited; use a paid provider in production):
#   https://mainnet.sorobanrpc.com | https://soroban-rpc.mainnet.stellar.gateway.fm | https://rpc.ankr.com/stellar_soroban
# AGENTPOS_RPC_URL=

# LLM router (scanner). Provider: anthropic | openai-compatible. Direct HTTP, no SDK.
AGENTPOS_LLM_PROVIDER=anthropic
AGENTPOS_LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
# For openai-compatible providers (OpenRouter, local servers...)
# AGENTPOS_LLM_BASE_URL=
# AGENTPOS_LLM_API_KEY=

# e2e smoke (packages/core/scripts/e2e-smoke.ts). Optional: a testnet account that holds USDC
# (fund at https://faucet.circle.com) to also exercise a real USDC payment.
# SMOKE_USDC_SOURCE_SECRET=S...

# Human approvals (M2). The secret signs resolutions: without it the sidecar refuses every
# approve/reject over HTTP (the local CLI still works, it owns the database).
AGENTPOS_APPROVAL_SECRET=
# Optional: signs the outgoing approval webhook so your system can trust it.
AGENTPOS_APPROVAL_WEBHOOK_SECRET=
# Optional: WhatsApp notifications through Twilio (no SDK, plain HTTP).
AGENTPOS_TWILIO_ACCOUNT_SID=
AGENTPOS_TWILIO_AUTH_TOKEN=
# Optional: critical operational alerts as JSON POSTs (G1 runbook).
AGENTPOS_ALERT_WEBHOOK=

# Verifiable receipts (M4). Optional: the key this store signs its receipts with. Leave it unset
# and the sidecar keeps its own in .agentpos/receipt-signer.json. It signs statements only:
# it holds no funds and must NEVER receive any. Back it up with the database.
# AGENTPOS_RECEIPT_SECRET=S...

# Self-hosted facilitator (apps/facilitator), optional. Only needed if you RUN one; a store that
# uses someone else's facilitator needs AGENTPOS_FACILITATOR_URL and _API_KEY instead.
# The signer pays transaction fees and must hold XLM and nothing else: it never holds buyer or
# seller funds. Fund the address the service prints on startup.
# AGENTPOS_FACILITATOR_SIGNER_SECRET=S...
# AGENTPOS_FACILITATOR_KEYS=key-one,key-two        # Bearer tokens you hand to your stores
# AGENTPOS_FACILITATOR_ASSETS=CBIELTK6...          # contract ids it will settle (no empty allowlist)
# AGENTPOS_FACILITATOR_NETWORK=testnet
# AGENTPOS_FACILITATOR_RPC_URL=                    # required on mainnet; it refuses to guess

# Buyer web (apps/buyer-web) WhatsApp channel, optional. Routes mount only when a provider's
# full variable set is present. Messaging credentials only: this service still holds no wallet
# key, and approving over WhatsApp only marks a proposal approved (signing stays local).
# Owner allowlist, comma-separated E.164. REQUIRED when any provider below is configured.
# WHATSAPP_ALLOWED_NUMBERS=+56912345678
# Meta WhatsApp Cloud API (webhook: GET/POST /whatsapp/meta)
# META_VERIFY_TOKEN=
# META_APP_SECRET=
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# Twilio WhatsApp (webhook: POST /whatsapp/twilio). TWILIO_WEBHOOK_URL is the exact public URL
# Twilio posts to (needed to validate X-Twilio-Signature behind a proxy).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=whatsapp:+14155238886
# TWILIO_WEBHOOK_URL=

# Signing bridge (buyer-web <-> agentpos-buyer watch), optional. Approving on web/WhatsApp only
# QUEUES a purchase; money moves solely on the machine that holds the wallet key. The token
# authorizes the buyer's OWN signer daemon against /api/signer/* and nothing else: it cannot
# approve proposals and it is not a wallet secret. Min 24 chars (openssl rand -hex 24).
# On the buyer-web server (routes are not mounted without it):
# SIGNER_TOKEN=
# On the machine that holds the wallet, for `agentpos-buyer watch <buyer-web-url>` (same value;
# environment only, never a CLI flag: flags leak into process lists):
# AGENTPOS_SIGNER_TOKEN=

# Supabase (hosted plane, optional)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # indexer only, never in the site library
