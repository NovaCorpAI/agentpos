# AgentGate: copy to .env and fill in. NEVER commit .env.

# Network: testnet (default) | mainnet. Mainnet also requires AGENTGATE_ALLOW_MAINNET=true
# (guardrail 2: mainnet needs explicit founder confirmation, see plan/ROADMAP.md gate G2).
AGENTGATE_NETWORK=testnet
AGENTGATE_ALLOW_MAINNET=false
# Checkout asset: USDC (default). XLM is testnet-only, used by automated e2e (friendbot gives XLM,
# not USDC). Mainnet refuses anything but USDC.
AGENTGATE_CHECKOUT_ASSET=USDC

# Facilitator (Built on Stellar). Defaults are set per network in packages/core/src/config.ts;
# override only if you run your own facilitator.
# AGENTGATE_FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
# Facilitator API key(s), comma-separated. REQUIRED for verify/settle/supported (verified
# 2026-08-25: /supported returns 401 without it). Generate at the URL in
# developers.stellar.org/docs/build/agentic-payments/x402/built-on-stellar (testnet: no login;
# mainnet: GitHub OAuth). The key cannot be retrieved after creation.
# Keys are PER NETWORK: set the network-specific variables and keep both; the generic one is a fallback.
AGENTGATE_FACILITATOR_API_KEY_TESTNET=
AGENTGATE_FACILITATOR_API_KEY_MAINNET=
AGENTGATE_FACILITATOR_API_KEY=

# Soroban RPC. Testnet has a public default; mainnet REQUIRES a URL (no public default in SDK).
# Public mainnet endpoints verified 2026-08-26 (rate limited; use a paid provider in production):
#   https://mainnet.sorobanrpc.com | https://soroban-rpc.mainnet.stellar.gateway.fm | https://rpc.ankr.com/stellar_soroban
# AGENTGATE_RPC_URL=

# LLM router (scanner). Provider: anthropic | openai-compatible. Direct HTTP, no SDK.
AGENTGATE_LLM_PROVIDER=anthropic
AGENTGATE_LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
# For openai-compatible providers (OpenRouter, local servers...)
# AGENTGATE_LLM_BASE_URL=
# AGENTGATE_LLM_API_KEY=

# e2e smoke (packages/core/scripts/e2e-smoke.ts). Optional: a testnet account that holds USDC
# (fund at https://faucet.circle.com) to also exercise a real USDC payment.
# SMOKE_USDC_SOURCE_SECRET=S...

# Human approvals (M2). The secret signs resolutions: without it the sidecar refuses every
# approve/reject over HTTP (the local CLI still works, it owns the database).
AGENTGATE_APPROVAL_SECRET=
# Optional: signs the outgoing approval webhook so your system can trust it.
AGENTGATE_APPROVAL_WEBHOOK_SECRET=
# Optional: WhatsApp notifications through Twilio (no SDK, plain HTTP).
AGENTGATE_TWILIO_ACCOUNT_SID=
AGENTGATE_TWILIO_AUTH_TOKEN=
# Optional: critical operational alerts as JSON POSTs (G1 runbook).
AGENTGATE_ALERT_WEBHOOK=

# Verifiable receipts (M4). Optional: the key this store signs its receipts with. Leave it unset
# and the sidecar keeps its own in .agentgate/receipt-signer.json. It signs statements only:
# it holds no funds and must NEVER receive any. Back it up with the database.
# AGENTGATE_RECEIPT_SECRET=S...

# Self-hosted facilitator (apps/facilitator), optional. Only needed if you RUN one; a store that
# uses someone else's facilitator needs AGENTGATE_FACILITATOR_URL and _API_KEY instead.
# The signer pays transaction fees and must hold XLM and nothing else: it never holds buyer or
# seller funds. Fund the address the service prints on startup.
# AGENTGATE_FACILITATOR_SIGNER_SECRET=S...
# AGENTGATE_FACILITATOR_KEYS=key-one,key-two        # Bearer tokens you hand to your stores
# AGENTGATE_FACILITATOR_ASSETS=CBIELTK6...          # contract ids it will settle (no empty allowlist)
# AGENTGATE_FACILITATOR_NETWORK=testnet
# AGENTGATE_FACILITATOR_RPC_URL=                    # required on mainnet; it refuses to guess

# Supabase (hosted plane, optional)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # indexer only, never in the site library
